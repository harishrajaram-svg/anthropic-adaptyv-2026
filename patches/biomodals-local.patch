+) -> list:
+    """Folds MANY fastas inside ONE container, reusing the loaded model.
+
+    THE SAME PATCH modal_esmfold2.py ALREADY CARRIES, for the same reason. reference/
+    wrapper-notes.md, "Batching: one complex per container was the real bottleneck": that wrapper
+    folded one complex per container, so 100 designs meant 100 model loads at ~137 s each, about
+    4 GPU-hours of pure loading before any useful work. Chai-1 was still in that state: measured
+    2026-10-11, two 554-residue complexes at 184 s and 185 s per fold with NO cold/warm spread,
+    because ~110 s of container start and model load is paid again on every single call while the
+    diffusion itself is ~70 s.
+
+    Timing is returned as `timing.tsv`, load and folds separately, because the per-fold cost is a
+    pre-registered gate in PREREG-CORR-TWO-ORACLE-2026-10-11.md and a number that mixes load into
+    fold is the thing that made that gate unreadable the first time.
+
+    Args:
+        inputs (list): [(name, faa_str)] -- `name` becomes the output subdirectory.
+        ... remaining args as `chai1`.
+
+    Returns:
+        list[tuple[Path, bytes]]: (relative path, content), each complex under `name/`.
+    """
+    import time
+    import torch
+    from tempfile import TemporaryDirectory
+    from chai_lab.chai1 import run_inference
+
+    out, timing = [], ["name\tphase\tseconds"]
+    t0 = time.time()
+    loaded = False
+    for name, faa_str in inputs:
+        with TemporaryDirectory() as td_in, TemporaryDirectory() as td_out:
+            fasta_path = Path(td_in) / f"{name}.faa"
+            fasta_path.write_text(faa_str)
+            t1 = time.time()
+            _ = run_inference(
+                fasta_file=Path(fasta_path),
+                output_dir=Path(td_out),
+                num_trunk_recycles=num_trunk_recycles,
+                num_diffn_timesteps=num_diffn_timesteps,
+                seed=seed,
+                device=torch.device("cuda:0"),
+                use_esm_embeddings=use_esm_embeddings,
+                **chai1_kwargs,
+            )
+            t2 = time.time()
+            # The FIRST call pays model load inside run_inference, so it is recorded as
+            # load+fold and excluded from the marginal rate. Every later call is marginal.
+            timing.append(f"{name}\t{'load_and_fold' if not loaded else 'fold'}\t{t2 - t1:.1f}")
+            loaded = True
+            for f in Path(td_out).glob("**/*"):
+                if f.is_file():
+                    out.append((Path(name) / f.relative_to(td_out), open(f, "rb").read()))
+    timing.append(f"ALL\ttotal_container\t{time.time() - t0:.1f}")
+    out.append((Path("timing.tsv"), ("\n".join(timing) + "\n").encode()))
+    return out

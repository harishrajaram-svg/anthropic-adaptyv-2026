+    # --- the one loss term the whole programme has failed to control -----------------
+    class AcidNearHis(LossTerm):
+        """Pull a binder carboxylate to within d0 of the anchor histidine's ring N.
+
+        Measured on CA, not on OD1/OD2: design features give the binder UNK/G reference
+        atoms, so the binder has NO SIDECHAINS during optimization (mosaic README). CA to
+        ring-N is the honest differentiable proxy -- an Asp CA can sit at most ~3.9 A from
+        its own carboxylate O, so d0=8.0 is the CA distance consistent with O within 4.0 A.
+        The real all-atom distance is measured after design by _geometry() on a
+        re-prediction, and that is the number the gate sees.
+
+        Shape is (acid probability at i) x sigmoid((d0 - d_i)/width), summed over i and
+        logged: smooth, rewards one well-placed carboxylate, and does not care which
+        position wins.
+        """
+        his_token: int
+        d_idx: int
+        e_idx: int
+        d0: float = 8.0
+        width: float = 1.5
+        eps: float = 1e-3
+
+        def __call__(self, sequence, output, key):
+            L = sequence.shape[0]
+            ca = output.atom37_coords[:L, A37["CA"]]
+            nd1 = output.atom37_coords[self.his_token, A37["ND1"]]
+            ne2 = output.atom37_coords[self.his_token, A37["NE2"]]
+            d = jnp.minimum(
+                jnp.linalg.norm(ca - nd1, axis=-1), jnp.linalg.norm(ca - ne2, axis=-1)
+            )
+            # CLIP IS LOAD-BEARING, do not remove it. APGM evaluates the loss at the
+            # extrapolated point `x + momentum*(x - x_prev)`, which is OFF the simplex:
+            # entries there can be negative or exceed 1. Unclipped, `score` could go
+            # negative, `total + eps` could reach <= 0, and `log` of a non-positive number
+            # is NaN -- which is exactly what happened on 5 of 180 steps in tune01 (2.8%),
+            # each one discarded by APGM's own NaN guard. The earlier comment here claimed
+            # clipping the loss "would flatten its gradient"; that was wrong in the way
+            # that matters. Clipping to [0,1] only zeroes this term's gradient at points
+            # that are not valid probability vectors. Inside the simplex -- where every
+            # real sequence lives -- the gradient is untouched.
+            acid = jnp.clip(
+                sequence[:, self.d_idx] + sequence[:, self.e_idx], 0.0, 1.0
+            )
+            score = acid * jax.nn.sigmoid((self.d0 - d) / self.width)
+            total = score.sum()
+            # `eps` sets how hard this term pushes when no carboxylate is placed at all:
+            # the loss maxes out at -log(eps), so 1e-3 peaks near 6.9 with a gradient of
+            # ~1000, and 0.1 peaks near 2.3. Left at 1e-3 so tune01 stays the comparable
+            # baseline; it is a parameter now so it can be swept deliberately instead of
+            # being changed by accident.
+            loss = -jnp.log(total + self.eps)
+            return loss, {
+                "acid_his": loss,
+                "acid_best": score.max(),
+                "acid_dmin_CA": jnp.min(d + (1.0 - acid) * 100.0),
+            }
+
+    class HisNearCation(LossTerm):
+        """Problem 2's MIRROR of AcidNearHis: pull a binder HISTIDINE to the target's cation.
+
+        Problem 1 placed a binder carboxylate against a TARGET histidine (EGFR H433). Problem 2
+        inverts the roles -- the titratable group moves to the BINDER and the target supplies a
+        fixed positive charge (TNF R108 or K166). Same shape, same clipping, same eps semantics;
+        only the two chemistries swap sides.
+
+        MEASURED ON CA, for the reason AcidNearHis gives: design features hand the binder UNK/G
+        reference atoms, so it has NO SIDECHAINS during optimization. CA-to-cation-N is the
+        honest differentiable proxy. A histidine CA sits at most ~3.4 A from its own ND1, so
+        d0 = 6.5 is the CA distance consistent with ND1 within ~3.1 A -- which is the geometry
+        s6d measured as reachable and s9 measured as the one the cation actually acts on.
+        The real all-atom distance is measured after design by _geometry() on a re-prediction.
+
+        WHY THIS TERM IS WORTH HAVING EVEN THOUGH THE FILTERS ARE DEAD. s19/s20 retired
+        dddG_elec and his_cation_gate as SELECTORS -- they cannot rank finished molecules. That
+        is a different job from supplying a GRADIENT. Nothing measured says the geometry is
+        unbuildable; s6d says the opposite (17.2% of approach directions are clear at K166).
+        A filter must discriminate among molecules that exist; a loss only has to point
+        downhill. s22 and s20 together mean both conditional objectives must now be DESIGNED
+        IN rather than selected for, and this is the only place in the pipeline where that can
+        happen for the pH mechanism.
+
+        🔴 REDUCTION IS top-k, NOT sum -- and this is a correction, not a preference. The
+        first version wrote `total = score.sum()`, mirroring AcidNearHis. Summing rewards
+        total histidine MASS in the neighbourhood rather than histidine PLACEMENT, and the
+        cheapest way down that gradient is to put histidine everywhere. The 5-step trimer
+        smoke returned 12 histidines in 76 residues -- 15.8% against a ~2.3% natural
+        frequency -- while `his_best` sat at exactly 0.00 every step, i.e. the loss fell the
+        whole way without ONE histidine ever being placed. Arithmetic on the sigmoid confirms
+        the incentive without needing a run: 12 histidines loitering at 9.0 A score -0.646
+        under sum and 1 histidine placed at 3.0 A scores +0.091, so sum strictly PREFERS the
+        spam. Under top-2 the same two cases are +1.143 and +0.091 and the placed histidine
+        wins. k = 2 rather than 1 because s24 measured 0.40 pKa units per site, so the ratio
+        arithmetic needs two sites and a max would pay for only one.
+
+        AcidNearHis still sums, and has the same structural incentive. It is left alone
+        deliberately: problem 1's submitted set came from BoltzGen/MPNN with point mutations,
+        never from a Mosaic trajectory, so nothing shipped is affected -- and problem 1 is
+        another session's. Flagged in challenges/01, not fixed here.
+        """
+        his_idx: int
+        cation_atoms: tuple
+        d0: float = 6.5
+        width: float = 1.5
+        eps: float = 1e-3
+        topk: int = 2
+
+        def __call__(self, sequence, output, key):
+            L = sequence.shape[0]
+            ca = output.atom37_coords[:L, A37["CA"]]
+            ds = [jnp.linalg.norm(ca - output.atom37_coords[self.his_idx, A37[a]], axis=-1)
+                  for a in self.cation_atoms]
+            d = ds[0]
+            for extra in ds[1:]:
+                d = jnp.minimum(d, extra)
+            # Clip for the same reason AcidNearHis clips: APGM evaluates at an extrapolated
+            # point off the simplex, where an entry can be negative or exceed 1, and an
+            # unclipped score can drive log() to NaN. Inside the simplex the gradient is
+            # untouched.
+            his = jnp.clip(sequence[:, TOKENS.index("H")], 0.0, 1.0)
+            score = his * jax.nn.sigmoid((self.d0 - d) / self.width)
+            total = his_reduce(score, self.topk, jnp)   # top-k, not sum -- see the docstring
+            loss = -jnp.log(total + self.eps)
+            return loss, {
+                "his_cation": loss,
+                "his_best": score.max(),
+                "his_topk": total,
+                "frac_H": his.mean(),
+                "his_dmin_CA": jnp.min(d + (1.0 - his) * 100.0),
+            }
+
+    class CompositionCap(LossTerm):
+        """Hinge penalty on over-represented residues. Zero until the cap is crossed."""
+        caps: tuple
+        name: str = "comp"
+
+        def __call__(self, seq, *, key):
+            total, aux = 0.0, {}
+            for token_idx, cap, label in self.caps:
+                frac = seq[:, token_idx].mean()
+                total = total + jax.nn.relu(frac - cap)
+                aux[f"f_{label}"] = frac
+            return total, {self.name: total, **aux}
+
+    model = Boltz2()
+
+    def build_interface_loss(*, loss, features):
+        """Boltz2 loss for a leg that carries the interface/pH terms.

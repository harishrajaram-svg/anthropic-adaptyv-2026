+# /// script
+# requires-python = ">=3.12"
+# dependencies = ["modal>=1.0"]
+# ///
+"""Mosaic (escalante-bio) on Modal. Steps 1-3 probe the environment; step 4 designs.
+
+Why a bespoke wrapper: Mosaic has no CLI. It is driven by its Python API, so the Modal
+function must EMBED the design script rather than shell out, unlike every other wrapper
+in biomodals/.
+
+  step 1  probe          JAX sees a CUDA GPU                          PASSED 2026-10-02
+  step 2  probe_mosaic   mosaic imports, loss terms compose           PASSED 2026-10-02
+  step 3  fetch_weights  8.03 GB of Boltz-2 cached on the Volume      PASSED 2026-10-02
+  step 4  design         gradient design against the H433 patch       <- written 2026-10-03
+
+Step 4's non-GPU logic (target prep, the numbering arithmetic, the geometry check) has a
+local self-test that needs no GPU and no Modal account: bin/mosaic_selftest.py. Run it
+before paying for a GPU; a wrong index here is a wasted run.
+
+Scope and constraints: projects/anthropic-adaptyv-2026/mosaic-wrapper-scope.md
+C1 (BLOCKING): the design loss may NOT contain ipSAE and may NOT run on ESMFold2 — that is
+our frozen ranking instrument, and designing against it makes December's analysis
+unanswerable. Design on Boltz-2 or Protenix. ESMFold2 is permitted for plumbing smoke
+tests only, and those designs are discarded, never submitted.
+
+Run:  GPU=L40S modal run modal_mosaic.py
+"""
+import os
+
+from modal import App, Image, Volume
+
+GPU = os.environ.get("GPU", "L40S")          # 48 GB; scope says 24 GB min, 48 GB+ recommended
+TIMEOUT = int(os.environ.get("TIMEOUT", 30))
+
+# Weights live in a Volume, not the image: they are large, shared across runs, and change
+# independently of the code. Same pattern as modal_germinal.py.
+weights = Volume.from_name("mosaic-weights", create_if_missing=True)
+
+image = (
+    Image.debian_slim(python_version="3.12")   # Mosaic needs >=3.11
+    .apt_install("git")
+    # Germinal's image proved jax[cuda12] installs cleanly on Modal this morning; this is the
+    # modern spelling of the same thing. If it ever fails, Germinal's fallback is
+    # pip install 'jax[cuda12_pip]==0.5.3' -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html
+    .uv_pip_install("jax[cuda12]")
+    # STEP 2: Mosaic itself. It has no release on PyPI, so install from the repo. Its own
+    # README warns it "may require substantial hand-holding (tuning learning rates, etc)"
+    # and "often produces proteins that fail simple in-silico tests" -- downstream
+    # protein-qc filtering is mandatory, not optional (constraint C4).
+    # PINNED 2026-10-07. Unpinned, a fresh clone resolved Mosaic to whatever HEAD was that
+    # day, so the reproducibility claim in METHODS 13 was wider than the evidence. b94b9d4
+    # (2026-09-24) is the commit the wrapper was read against and the code every run in
+    # this project executed: b94b9d4..1eb4af6 is +21/-0 across CITATION.cff and README.md,
+    # measured against the GitHub compare API, so no Python changed under us mid-campaign.
+    .uv_pip_install("git+https://github.com/escalante-bio/mosaic@b94b9d4eb9907a700a6d78ed2d29d3704c5df46c")
+)
+
+app = App("mosaic", image=image)
+
+
+@app.function(image=image, gpu=GPU, timeout=TIMEOUT * 60,
+              volumes={"/weights": weights})
+def probe():
+    """Step 1 success criterion: jax.devices() lists a GPU and a real matmul runs on it."""
+    import jax
+    import jax.numpy as jnp
+
+    print(f"[mosaic] jax {jax.__version__}")
+    print(f"[mosaic] backend: {jax.default_backend()}")
+    devs = jax.devices()
+    print(f"[mosaic] jax.devices(): {devs}")
+    gpus = [d for d in devs if d.platform == "gpu"]
+    if not gpus:
+        raise SystemExit("STEP 1 FAILED: no GPU in jax.devices()")
+    x = jnp.ones((2048, 2048))
+    y = float((x @ x).sum())
+    print(f"[mosaic] matmul on {gpus[0]}: sum={y:.0f} (expect 8589934592)")
+    print(f"[mosaic] weights volume writable: {os.access('/weights', os.W_OK)}")
+    print("[mosaic] STEP 1 PASSED")
+    return {"jax": jax.__version__, "devices": [str(d) for d in devs]}
+
+
+@app.function(image=image, gpu=GPU, timeout=TIMEOUT * 60,
+              volumes={"/weights": weights})
+def probe_mosaic():
+    """Step 2 success criterion: mosaic imports and a composable loss can be constructed.
+
+    Deliberately does NOT build the published Nipah loss. That loss contains ipSAE and runs
+    on ESMFold2, which is our frozen ranking instrument (constraint C1) -- using it would
+    make December's question "did our ranking predict binding?" unanswerable. This only
+    checks that the loss algebra works; the real objective gets composed on Boltz-2.
+    """
+    import jax
+    print(f"[mosaic] jax {jax.__version__}  devices {jax.devices()}")
+    import mosaic
+    print(f"[mosaic] mosaic imported from {mosaic.__file__}")
+    import mosaic.losses.structure_prediction as sp
+    print("[mosaic] structure_prediction loss terms available:")
+    terms = [n for n in dir(sp) if n[0].isupper()]
+    print("   " + ", ".join(terms))
+    # the loss algebra: terms compose with + and scale with *
+    loss = sp.BinderTargetContact() + sp.WithinBinderContact() + 0.1 * sp.PLDDTLoss()
+    print(f"[mosaic] composed a 3-term loss OK: {type(loss).__name__}")
+    print("[mosaic] STEP 2 PASSED")
+    return {"terms": terms}
+
+
+@app.function(image=image, gpu=GPU, timeout=TIMEOUT * 60,
+              volumes={"/weights": weights})
+def fetch_weights():
+    """Step 3: pull the design-model weights into the Volume so runs do not re-download.
+
+    Boltz-2, not ESMFold2: constraint C1 reserves ESMFold2 for ranking. Caching matters
+    because JIT plus a cold weight fetch dominates the first call, and Mosaic needs many
+    calls while a learning rate is being tuned.
+    """
+    # Env vars must be set BEFORE importing anything that reads them at import time.
+    import os
+    os.environ["HF_HOME"] = "/weights/hf"
+    os.environ["HUGGINGFACE_HUB_CACHE"] = "/weights/hf/hub"
+    os.environ["TORCH_HOME"] = "/weights/torch"
+    os.environ["XDG_CACHE_HOME"] = "/weights/xdg"
+    for d in ("/weights/hf/hub", "/weights/torch", "/weights/xdg", "/weights/mosaic"):
+        os.makedirs(d, exist_ok=True)
+    # Mosaic ignores HF_HOME/TORCH_HOME: it keeps its OWN cache at ~/.cache/mosaic and the
+    # only documented override is a --cache CLI flag, which does not exist when driving the
+    # Python API. Symlink the path it actually uses onto the Volume instead.
+    import shutil
+    real = "/root/.cache/mosaic"
+    os.makedirs("/root/.cache", exist_ok=True)
+    if os.path.islink(real):
+        pass
+    elif os.path.isdir(real):
+        shutil.rmtree(real)
+    if not os.path.islink(real):
+        os.symlink("/weights/mosaic", real)
+    print(f"[mosaic] {real} -> {os.path.realpath(real)}")
+    import jax
+    print(f"[mosaic] jax {jax.__version__} devices {jax.devices()}")
+    import mosaic, mosaic.models
+    print("[mosaic] mosaic.models exposes:", [n for n in dir(mosaic.models) if not n.startswith("_")])
+    got = []
+    try:
+        from mosaic.models.boltz2 import Boltz2
+        print("[mosaic] Boltz2 class imported; instantiating (this pulls weights)...")
+        m = Boltz2()
+        print("[mosaic] Boltz2 constructed; forcing weight download...")
+        for attr in ("load", "load_weights", "_load", "download", "params", "model"):
+            if hasattr(m, attr):
+                a = getattr(m, attr)
+                try:
+                    a() if callable(a) else repr(a)
+                    print(f"[mosaic]   touched .{attr}")
+                except Exception as e:
+                    print(f"[mosaic]   .{attr} raised {type(e).__name__}: {str(e)[:120]}")
+        print("[mosaic] Boltz2 attributes:", [x for x in dir(m) if not x.startswith("_")][:25])
+        got.append("boltz2")
+    except Exception as e:
+        print(f"[mosaic] Boltz2 unavailable: {type(e).__name__}: {str(e)[:300]}")
+    total = 0
+    for sub in ("hf", "torch", "xdg", "mosaic"):
+        d = f"/weights/{sub}"
+        n = sum(len(f) for _, _, f in os.walk(d)) if os.path.isdir(d) else 0
+        sz = sum(os.path.getsize(os.path.join(r, f)) for r, _, fs in os.walk(d) for f in fs) if os.path.isdir(d) else 0
+        total += sz
+        print(f"[mosaic] /weights/{sub}: {n} files, {sz/1e9:.2f} GB")
+    weights.commit()
+    # Success is BYTES ON THE VOLUME, not "the class constructed". Constructing Boltz2 is
+    # lazy and downloads nothing, so the previous criterion passed against an empty Volume.
+    ok = total > 1e8
+    print(f"[mosaic] total cached: {total/1e9:.2f} GB")
+    print("[mosaic] STEP 3 " + ("PASSED" if ok else f"FAILED - only {total/1e9:.2f} GB on the Volume"))
+    return {"cached": got, "bytes": total}
+
+
+# ----------------------------------------------------------------- STEP 4: design
+#
+# WHY MOSAIC IS THE RIGHT TOOL HERE (the reversal, recorded in methods-stack.md):
+# two different problems were being conflated.
+#   supply    -- is a carboxylate present at all?  BoltzGen `sequence:` pinning, 80/80.
+#   placement -- is it within 4.0 A of H433 ND1/NE2 WHILE the binder folds and binds?
+#                2/160 by sampling, and the single hit does not fold.
+# Placement is irreducibly a continuous multi-objective problem, so it belongs in a
+# written objective rather than a post-hoc filter. Each of the week's three failure
+# modes has a loss term: ipSAE_min 0.0000 -> IPTM/PAE, binder pLDDT 37 -> PLDDTLoss +
+# globularity, salt-bridge geometry 2/160 -> BinderTargetContact + the custom
+# AcidNearHis term below.
+#
+# NUMBERING -- READ THIS BEFORE CHANGING AN INDEX.
+# Four schemes are live in this project and mixing them has cost real money. Everything
+# below speaks exactly one: POSITIONAL in egfr_ecd_6aru_renum.pdb, contiguous 1..609,
+# where positional = canonical - 27. So canonical H433 -> 406, and the declared patch
+# 403..409 == canonical 430..436 == motif TKQHGQF (bin/make_tight_specs.py carries the
+# same patch and the same independent motif check). BoltzGen's OUTPUT files use yet
+# another offset -- H433 -> 409, which is what bin/ph_gate_target_his.py CANON encodes --
+# so for the files THIS function writes that gate needs CANON = {406: "H433"}. Every run
+# ships a numbering.json saying so, so nobody re-derives it.
+#
+# C1 (BLOCKING, frozen-decisions.md): no ipSAE term and no ESMFold2 anywhere in the
+# design loss -- that is the frozen ranking instrument. Design runs on Boltz-2 and
+# ipSAE_min is held back for ranking. ESMFoldGlobularity is NOT an ESMFold2 model: it is
+# a model-agnostic radius-of-gyration term on whatever distogram it is handed (see
+# mosaic/losses/structure_prediction.py), here Boltz-2's. Permitted.
+#
+# WHAT MOSAIC STILL CANNOT DO: there is no pKa term and PROPKA is not differentiable.
+# The pH switch stays a post-hoc selector. Division of labour: Mosaic holds fold + bind +
+# contact geometry, then bin/ph_gate_target_his.py gates, then bin/knockout_control.py.
+
+TOKENS = "ARNDCQEGHILKMFPSTWYV"              # mosaic.common.TOKENS, mirrored for local use
+A37 = {"CA": 1, "ND1": 14, "NE2": 25,         # mosaic.losses.atom37.ATOM37_NAMES order
+       "OD1": 16, "OD2": 17, "OE1": 26, "OE2": 27,
+       # --- problem 2 (TNF) adds the CATION nitrogens. The mechanism is MIRRORED:
+       # problem 1 put a binder ACID against a TARGET histidine (EGFR H433); problem 2
+       # puts a binder HISTIDINE against a TARGET cation (TNF R108 / K166). Indices
+       # verified against the standard atom37 ordering, in which the seven above also
+       # land exactly where this dict already says they do.
+       "NE": 23, "NH1": 29, "NH2": 30, "NZ": 35}
+ARG_CATION_N = ("NE", "NH1", "NH2")
+LYS_CATION_N = ("NZ",)
+DEFAULT_CROP = (284, 453)                     # domain III, positional (== canonical 311..480)
+DEFAULT_EPITOPE = "403,404,405,406,407,408,409"
+ANCHOR = 406                                  # H433, positional
+
+
+def _cache_env():
+    """Point every cache mosaic uses at the Volume. Must run before importing mosaic.
+
+    Same trick as fetch_weights(): mosaic ignores HF_HOME/TORCH_HOME and keeps its own
+    cache at ~/.cache/mosaic, whose only documented override is a --cache CLI flag that
+    does not exist when driving the Python API. Symlink instead. 8.03 GB is already on
+    the Volume, so this is the difference between a 30-second start and a 10-minute one.
+    """
+    import os
+    import shutil
+
+    os.environ["HF_HOME"] = "/weights/hf"
+    os.environ["HUGGINGFACE_HUB_CACHE"] = "/weights/hf/hub"
+    os.environ["TORCH_HOME"] = "/weights/torch"
+    os.environ["XDG_CACHE_HOME"] = "/weights/xdg"
+    for d in ("/weights/hf/hub", "/weights/torch", "/weights/xdg", "/weights/mosaic"):
+        os.makedirs(d, exist_ok=True)
+    real = "/root/.cache/mosaic"
+    os.makedirs("/root/.cache", exist_ok=True)
+    if os.path.isdir(real) and not os.path.islink(real):
+        shutil.rmtree(real)
+    if not os.path.islink(real):
+        os.symlink("/weights/mosaic", real)
+
+
+def _prepare_target(pdb_path, chain_id: str, crop):
+    """Polymer chain + sequence + positional residue numbers, from a PDB on disk.
+
+    Boltz "wants perfect cifs" (mosaic/models/boltz2.py:build_template_yaml), and the
+    template's declared full_sequence is read straight off the chain's residue names, so
+    waters, ligands, altlocs and hydrogens have to go or the template silently mismatches
+    the sequence we pass alongside it.
+    """
+    import gemmi
+
+    st = gemmi.read_structure(str(pdb_path))
+    st.setup_entities()
+    st.remove_alternative_conformations()
+    st.remove_hydrogens()
+    st.remove_ligands_and_waters()
+    residues = [
+        r for r in st[0][chain_id]
+        if (info := gemmi.find_tabulated_residue(r.name)) and info.is_amino_acid()
+    ]
+    if crop is not None:
+        lo, hi = crop
+        residues = [r for r in residues if lo <= r.seqid.num <= hi]
+    chain = gemmi.Chain(chain_id)
+    for r in residues:
+        chain.add_residue(r)
+    resnums = [r.seqid.num for r in residues]
+    sequence = gemmi.one_letter_code([r.name for r in residues]).upper()
+    if len(sequence) != len(resnums) or "X" in sequence:
+        raise SystemExit(f"STEP 4 FAILED: non-standard residue in target: {sequence}")
+    return chain, sequence, resnums
+
+
+def parse_epitope(spec):
+    """Positions from an epitope spec. '', 'none' and 'free' all mean a FREE FOOTPRINT.
+
+    Module level, and used by BOTH legs, for the reason his_reduce is module level: when
+    only the human leg understood 'none', the free-footprint family was unreachable with
+    the species leg on. --epitope none freed the human leg, then the species validation
+    rejected an empty --target2-epitope as a MISSING FLAG rather than a deliberate free
+    footprint, so there was no way to express "both legs free" -- the only configuration
+    the symmetry check below will accept once the human leg is free.
+    """
+    if spec is None or str(spec).strip().lower() in ("", "none", "free"):
+        return []
+    return [int(v) for v in str(spec).split(",")]
+
+
+def fmt_epitope(epitope_idx):
+    """Render the footprint for the run banner, tolerating the free-footprint None.
+
+    epitope_idx is None (not []) on the free path, because upstream BinderTargetContact
+    reads None as "no restriction". A bare len() here raised TypeError AFTER the container
+    had paid for cold start and the Boltz-2 weight load.
+    """
+    return "free" if epitope_idx is None else str(len(epitope_idx))
+
+
+def _prepare_target_set(label, target_path, chain_csv, crop_t, epitope_pos,
+                        anchor, anchor_chain, mechanism):
+    """Prepare one TARGET SPECIES: chains, per-chain offsets, epitope indices, anchor.
+
+    Factored out so the human and mouse legs run the SAME index arithmetic instead of two
+    copies of it. That matters here specifically: both of this file's 2026-10-06 bugs lived
+    in this block (a stale `resnums` after the multi-chain rewrite, and an epitope applied to
+    one protomer instead of all three), and a second hand-written copy for mouse would be a
+    second place for them to come back.
+
+    `label` only tags the log lines, so a reader can tell which species a number belongs to.
+
+    TWO INDEX SPACES, AND THEY ARE NOT THE SAME:
+      epitope_idx  TARGET-relative. BinderTargetContact slices [:L, L:] first, then indexes
+                   columns, so these are offsets into the CONCATENATED target, excluding L.
+      anchor_local TARGET-relative too; the caller adds L, because the loss terms index
+                   output.atom37_coords directly and so carry the binder's length.
+    Both need a per-chain offset; only one needs L. Getting that wrong silently aims the
+    mechanism at whatever residue happens to sit at the stale index.
+
+    MOUSE EPITOPE POSITIONS ARE NOT THE HUMAN ONES. A deletion near human positional 68
+    shifts the register, so the offset is -3 at the anchor and -4 further along. The mapping
+    is computed from a pairwise alignment of the OBSERVED chains and stored in
+    analysis/02-tnf/epitope_conserved.json; it is passed in, never inferred here.
+    """
+    chain_ids = [c.strip() for c in chain_csv.split(",") if c.strip()]
+    chains_prepared, target_seqs, offsets, off = [], [], {}, 0
+    for cid in chain_ids:
+        ch_i, seq_i, resnums_i = _prepare_target(target_path, cid, crop_t)
+        idx_i = {num: j for j, num in enumerate(resnums_i)}
+        missing = [p for p in epitope_pos + ([anchor] if cid == anchor_chain else [])
+                   if p not in idx_i]
+        if missing:
+            raise SystemExit(f"STEP 4 FAILED [{label}]: positions {missing} are not in "
+                             f"chain {cid} crop {crop_t}")
+        chains_prepared.append((cid, ch_i, seq_i, idx_i, resnums_i))
+        target_seqs.append(seq_i)
+        offsets[cid] = off
+        off += len(seq_i)
+    if anchor_chain not in offsets:
+        raise SystemExit(f"STEP 4 FAILED [{label}]: anchor_chain {anchor_chain!r} is not in "
+                         f"chains {chain_ids}")
+
+    # epitope on EVERY protomer: the trimer is a homotrimer, the same positional residues are
+    # the epitope on each copy, and the binder sits in a seam between two of them. Rewarding
+    # contact with any copy is the honest statement of that; restricting to one would re-impose
+    # the single-protomer assumption the multi-chain change exists to remove.
+    epitope_idx = [offsets[cid] + idx_i[p]
+                   for cid, _ch, _s, idx_i, _rn in chains_prepared for p in epitope_pos]
+    _ac, _ach, a_seq, a_idx, _arn = next(c for c in chains_prepared if c[0] == anchor_chain)
+    anchor_local = offsets[anchor_chain] + a_idx[anchor]
+    anchor_aa = a_seq[a_idx[anchor]]
+    target_seq = "".join(target_seqs)
+
+    print(f"[mosaic] [{label}] chains {chain_ids} crop={crop_t} "
+          f"lens={[len(s) for s in target_seqs]} total={len(target_seq)}")
+    print(f"[mosaic] [{label}] chain offsets (target-relative) {offsets}")
+    if epitope_pos:
+        print(f"[mosaic] [{label}] epitope {len(epitope_pos)} positions x {len(chain_ids)} "
+              f"chains -> {len(epitope_idx)} target idx")
+    else:
+        print(f"[mosaic] [{label}] FREE FOOTPRINT: no epitope restriction -- contact is "
+              f"rewarded against any of {len(target_seq)} target residues (s41 family B). "
+              f"The anchor is still pinned.")
+    print(f"[mosaic] [{label}] anchor positional {anchor} on chain {anchor_chain} "
+          f"-> target idx {anchor_local} = {anchor_aa}")
+
+    MECHANISMS = ("acid_near_his", "his_near_cation")
+    if mechanism not in MECHANISMS:
+        raise SystemExit(f"STEP 4 FAILED: mechanism {mechanism!r} not in {MECHANISMS}")
+    want = "H" if mechanism == "acid_near_his" else "RK"
+    if anchor_aa not in want:
+        raise SystemExit(
+            f"STEP 4 FAILED [{label}]: anchor {anchor} is {anchor_aa}, not one of {want!r} "
+            f"for mechanism {mechanism!r} -- numbering or mechanism is wrong")
+    print(f"[mosaic] [{label}] mechanism {mechanism}: anchor {anchor_aa}{anchor} on the TARGET")
+    return {"chain_ids": chain_ids, "chains_prepared": chains_prepared,
+            "offsets": offsets, "epitope_idx": epitope_idx,
+            "anchor_local": anchor_local, "anchor_aa": anchor_aa,
+            "target_seq": target_seq, "target_seqs": target_seqs}
+
+
+def check_cation_atoms(anchor_aa: str, cation_atoms: tuple, label: str) -> None:
+    """Assert the cation atom set matches the anchor residue, BEFORE any GPU work.
+
+    An unmodelled atom37 slot is (0,0,0), not absent -- scatter_atom37 zero-initialises the
+    grid -- so asking for NZ on an arginine, or any ARG/LYS atom on a histidine, makes
+    HisNearCation measure every binder CA to the coordinate ORIGIN. It then returns a
+    gradient-free constant that logs as `his_cation: 6.91`, indistinguishable from an honest
+    "no histidine placed yet". That is how the species leg silently contributed nothing.
+
+    This check lives HERE, not inside the loss. The first version asserted on
+    `output.atom37_mask` inside `__call__`, which raised ConcretizationTypeError: you cannot
+    call float() on a traced array under jit, and you cannot branch on one. The values needed
+    are known before the GPU is touched, so the check belongs at construction.
+    """
+    want = {"R": ARG_CATION_N, "K": LYS_CATION_N}.get(anchor_aa)
+    if want is None:
+        raise SystemExit(
+            f"STEP 4 FAILED [{label}]: HisNearCation needs an R or K anchor; got {anchor_aa!r}. "
+            f"A histidine anchor means the mechanism is acid_near_his, not his_near_cation."
+        )
+    if tuple(cation_atoms) != tuple(want):
+        raise SystemExit(
+            f"STEP 4 FAILED [{label}]: anchor is {anchor_aa} but cation_atoms={cation_atoms}, "
+            f"expected {want}. Those atoms are unmodelled on a {anchor_aa}, so the term would "
+            f"measure to the coordinate origin and return a constant."
+        )
+
+
+def his_reduce(score, topk, xp):
+    """The reduction HisNearCation applies to its per-position scores.
+
+    Module level, and taking its array module as an argument, so that the loss term running
+    on jnp inside Modal and bin/mosaic_selftest.py running on numpy on a laptop exercise ONE
+    definition. Writing the formula twice would make the test agree with a copy of the code
+    rather than with the code. `xp.sort` is differentiable under jax -- it is a permutation,
+    so gradient routes to whichever positions are currently best -- which a hard
+    index-select would not be.
+    """
+    # [-0:] is the WHOLE array, so topk=0 reproduces exactly the score.sum() formulation this
+    # function exists to replace -- and the mutation test would not catch it, since it only
+    # ever passes 2. Fail loudly instead.
+    if topk < 1:
+        raise ValueError(f"topk must be >= 1; topk=0 silently restores the summed form")
+    return xp.sort(score)[-topk:].sum()
+
+
+def _geometry_p2(st, anchor_resnum: int, anchor_chain_idx: int = 0):
+    """Problem 2's mirror: shortest binder-HISTIDINE ring-N to target CATION-N distance.
+
+    Same role as _geometry() and the same discipline: this runs BEFORE any pKa, because a
+    histidine that is not actually near the cation cannot switch whatever a pKa predictor
+    says. Problem 1's version caught a 3.59x "switch" whose binder sat 27 A away; the failure
+    mode is identical here with the chemistries swapped.
+
+    s9 measured the cation's effect at an ND1-to-N distance of 3.0 A, and s6d measured that
+    geometry as reachable, so 4.0 A is the same generous bar problem 1 used.
+    """
+    # MULTI-CHAIN: chain 0 is the binder and EVERY chain after it is a target protomer. The
+    # first version read st[0][1] alone, which on a trimer silently measured against protomer A
+    # no matter which chain the anchor was actually declared on -- a wrong number, not an error.
+    # THE ANCHOR IS ON ONE SPECIFIC PROTOMER. This searched `for t in targets` and took the
+    # FIRST ARG/LYS at that residue number, with no idea which chain the loss was aimed at.
+    # TNF is a HOMOTRIMER: after renumbering, chains B, C and D all carry ARG 27. So with
+    # --anchor-chain B the loss pulled toward protomer B's R108 while this measured protomer
+    # A's, and a perfectly placed histidine was reported at ~30 A with geometry_pass False.
+    # Every geometry number produced before 2026-10-06 19:40 has that defect.
+    #
+    # The earlier comment claimed this was fixed by searching all chains instead of st[0][1].
+    # It was not: searching all chains is the bug, because the matches are indistinguishable.
+    # bin/mosaic_selftest.py could not catch it because its decoy protomers were ALA, so the
+    # ("ARG","LYS") filter made the search unambiguous -- a property the real trimer lacks.
+    binder, targets = st[0][0], list(st[0])[1:]
+    if not 0 <= anchor_chain_idx < len(targets):
+        return {}
+    cat = next((r for r in targets[anchor_chain_idx]
+                if r.seqid.num == anchor_resnum and r.name in ("ARG", "LYS")), None)
+    if cat is None:
+        return {}
+    names = ARG_CATION_N if cat.name == "ARG" else LYS_CATION_N
+    pts = [a.pos for a in cat if a.name in names]
+    if not pts:
+        return {}
+    best_n, best_ca, best_res = 1e9, 1e9, None
+    for r in binder:
+        if r.name != "HIS":
+            continue
+        for a in r:
+            if a.name not in ("ND1", "NE2", "CA"):
+                continue
+            d = min(a.pos.dist(p) for p in pts)
+            if a.name == "CA":
+                best_ca = min(best_ca, d)
+            elif d < best_n:
+                best_n, best_res = d, f"{r.name}{r.seqid.num}"
+    if best_res is None:
+        return {"his_N_to_cation_N": None, "geometry_pass": False,
+                "note": "no histidine in the binder"}
+    return {"his_N_to_cation_N": round(best_n, 2),
+            "his_CA_to_cation_N": round(best_ca, 2),
+            "closest_his": best_res,
+            "geometry_pass": bool(best_n <= 4.0)}
+
+
+def _geometry(st, anchor_resnum: int, anchor_chain_idx: int = 0):
+    """Shortest binder-carboxylate-O to anchor-His-N distance in a written complex.
+
+    This is verification step 1 and it runs BEFORE any pKa: >4.0 A cannot be a switch
+    whatever PROPKA says. The check that caught a 3.59x "switch" whose binder sat 27 A
+    from the histidine was exactly this one.
+    """
+    # Same defect as _geometry_p2 had: this read st[0][1] unconditionally. Harmless while
+    # problem 1's EGFR target is a monomer, wrong the first time acid_near_his is run
+    # multi-chain, so it is parameterised rather than left as a latent trap.
+    binder = st[0][0]
+    _targets = list(st[0])[1:]
+    if not 0 <= anchor_chain_idx < len(_targets):
+        return {}
+    target = _targets[anchor_chain_idx]
+    his = next((r for r in target if r.seqid.num == anchor_resnum), None)
+    if his is None:
+        return {}
+    ring = [a.pos for a in his if a.name in ("ND1", "NE2")]
+    if not ring:
+        return {}
+    best_o, best_ca, best_res = 1e9, 1e9, None
+    for r in binder:
+        if r.name not in ("ASP", "GLU"):
+            continue
+        for a in r:
+            if a.name not in ("OD1", "OD2", "OE1", "OE2", "CA"):
+                continue
+            d = min(a.pos.dist(p) for p in ring)
+            if a.name == "CA":
+                best_ca = min(best_ca, d)
+            elif d < best_o:
+                best_o, best_res = d, f"{r.name}{r.seqid.num}"
+    return {
+        "acid_O_to_his_N": None if best_o > 1e8 else round(best_o, 2),
+        "acid_CA_to_his_N": None if best_ca > 1e8 else round(best_ca, 2),
+        "closest_acid": best_res,
+        "geometry_pass": None if best_o > 1e8 else bool(best_o <= 4.0),
+    }
+
+
+# Both bugs found in this file on 2026-10-03 were caught by looking at ONE number and
+# knowing what it had to be, not by reading the code: `iptm_repred` pinned at exactly
+# 0.0 (IPTMLoss handed a zero-length sequence) and `acid_dmin_CA` reported as -39.59 A
+# (APGM evaluates the loss at an extrapolated point off the simplex, so `1 - acid` goes
+# negative). Both printed as plausible numbers next to a clean exit code. These two
+# functions turn "a reviewer might notice" into "the run refuses to lie".
+
+# (column, low, high, closed_low, closed_high) -- None means unbounded on that side.
+METRIC_BOUNDS = (
+    ("iptm_design", 0.0, 1.0, False, True),        # exactly 0.0 is the IPTMLoss artifact
+    ("iptm_repred", 0.0, 1.0, False, True),
+    ("iptm_repred_best_pair", 0.0, 1.0, False, True),
+    ("plddt_binder_design", 0.0, 1.0, False, True),
+    ("plddt_binder_repred", 0.0, 1.0, False, True),
+    ("frac_V", 0.0, 1.0, True, True),
+    ("frac_G", 0.0, 1.0, True, True),
+    ("frac_H", 0.0, 1.0, True, True),
+    # The problem-2 distance columns. Their absence meant the bounds and NaN checks never
+    # applied to a his_near_cation row -- the same mirrored-for-one-mechanism-only gap that
+    # GEOMETRY_KEYS had, found in the same review.
+    ("his_N_to_cation_N", 0.0, 200.0, True, True),
+    ("his_CA_to_cation_N", 0.0, 200.0, True, True),
+    ("acid_O_to_his_N", 0.0, 200.0, True, True),   # a distance is never negative
+    ("acid_CA_to_his_N", 0.0, 200.0, True, True),
+)
+GEOMETRY_BAR = 4.0
+
+
+# D-P2-1: geometry is UNINFORMATIVE BELOW BINDING, so it is not reported below this iptm.
+# Set from the negative side, where the measurements are: the voided LT-alpha dead fold read
+# 0.408-0.417 over 5 seeds and the 5-step non-binders read 0.11-0.31, while the measured G1
+# binders (adalimumab + Schroter PSV#1/2/3, KD 4.6-112 pM) read 0.77-0.86 over 20. It is a
+# NECESSARY condition only -- deliberately NOT set at 0.77, because those are Fabs, s16 found
+# no transferable thresholds between formats, and a correctly folded NON-binder (the corrected
+# G4) reads 0.46. Above this bar means "geometry is worth reading", never "this binds".
+GEOMETRY_IPTM_BAR = 0.45
+
+# The geometry keys differ by mechanism, and reading only problem 1's left BOTH geometry guards
+# inert on every his_near_cation row -- a guard passing while blind, s25's pattern, found
+# 2026-10-06 while implementing D-P2-1.
+GEOMETRY_KEYS = (("acid_O_to_his_N", "closest_acid"),       # acid_near_his  (problem 1)
+                 ("his_N_to_cation_N", "closest_his"))      # his_near_cation (problem 2)
+
+
+def gate_geometry(row: dict, bar: float = GEOMETRY_IPTM_BAR) -> dict:
+    """D-P2-1. Below `bar`, geometry_pass becomes None ("n/a"), never False.
+
+    False asserts the titratable residue WAS measured and found misplaced. Below the bar the
+    binder is not bound, so nothing about placement was measured and False is a false claim --
+    p2trimer02 "passed" at 3.15 A while carrying 12 histidines, and p2species02 "failed" at
+    20.36 A with iptm 0.178; neither number was about histidine placement.
+
+    The DISTANCE is kept. It is a real measurement of the re-predicted pose; only the verdict
+    is withdrawn. Gating uses `iptm_repred`, because geometry is measured on the RE-PREDICTION
+    and gating on design-time iptm would gate on a different structure.
+    """
+    iptm = row.get("iptm_repred")
+    if iptm is None or iptm != iptm:                 # absent or NaN -> cannot gate, fail closed
+        row["geometry_read"] = False
+        row["geometry_gate"] = "n/a: iptm_repred missing or NaN"
+        row["geometry_pass"] = None
+    elif iptm < bar:
+        row["geometry_read"] = False
+        row["geometry_gate"] = f"n/a: iptm_repred {iptm} < {bar} (D-P2-1)"
+        row["geometry_pass"] = None
+    else:
+        row["geometry_read"] = True
+        row["geometry_gate"] = f"read: iptm_repred {iptm} >= {bar}"
+    return row
+
+
+def check_row(row: dict, binder_length: int) -> list[str]:
+    """Impossible-value audit of one emitted design row. Returns a list of violations.
+
+    Checks what the quantity IS, not what it should ideally be: a distance cannot be
+    negative, a probability cannot exceed 1, NoCys means zero cysteine, and
+    geometry_pass must agree with the distance it was derived from. A bad DESIGN passes
+    every check here; only a bad MEASUREMENT fails.
+    """
+    bad = []
+    for col, lo, hi, closed_lo, closed_hi in METRIC_BOUNDS:
+        v = row.get(col)
+        if v is None:
+            continue                      # legitimately absent, e.g. no acid in the binder
+        if v != v:
+            bad.append(f"{col} is NaN")
+            continue
+        if v < lo or (v == lo and not closed_lo):
+            bad.append(f"{col}={v} violates lower bound {'[' if closed_lo else '('}{lo}")
+        if v > hi or (v == hi and not closed_hi):
+            bad.append(f"{col}={v} violates upper bound {hi}{']' if closed_hi else ')'}")
+    if row.get("n_C") not in (0, None):
+        bad.append(f"n_C={row['n_C']} but NoCys should make cysteine impossible")
+    if len(row.get("sequence", "")) != binder_length:
+        bad.append(f"sequence is {len(row.get('sequence', ''))} aa, expected {binder_length}")
+    passed = row.get("geometry_pass")
+    for dkey, rkey in GEOMETRY_KEYS:
+        if dkey not in row and rkey not in row:
+            continue                      # this mechanism's keys are simply not on this row
+        d = row.get(dkey)
+        if d is not None and passed is not None and passed != (d <= GEOMETRY_BAR):
+            bad.append(f"geometry_pass={passed} disagrees with {dkey}={d} "
+                       f"at the {GEOMETRY_BAR} A bar")
+        if (d is None) != (row.get(rkey) is None):
+            bad.append(f"{dkey} and {rkey} must be present or absent together")
+    # A withdrawn verdict must say so. geometry_pass=None with no gate recorded would be
+    # indistinguishable from a measurement that never ran.
+    # Distinguish "verdict PRESENT and withdrawn" from "geometry never computed". When
+    # _geometry* returns {} above the iptm bar, geometry_pass is ABSENT, not None -- and
+    # row.get() collapsed both to None, so a design whose metrics were fine got flagged
+    # METRICS SUSPECT and dropped from ranking by its own audit.
+    if ("geometry_pass" in row and row["geometry_pass"] is None
+            and "geometry_gate" in row and row.get("geometry_read") is not False):
+        bad.append("geometry_pass is None but geometry_read is not False")
+    return bad
+
+
+def loss_term_names(loss) -> list[str]:
+    """Every LossTerm class name in a composed loss, flattened, in order.
+
+    `LinearCombination` holds its members in `.l`, and model losses hold the inner loss
+    in `.loss`, so the whole tree walks. This is what makes C1 checkable: the previous
+    `no_ipsae_no_esmfold2: True` in config.json was a hardcoded literal that would have
+    printed True with IPSAE_min sitting in the objective. A claim, not evidence.
+    """
+    names = []
+    seen = set()
+
+    def walk(node, depth=0):
+        if node is None or depth > 12 or id(node) in seen:
+            return
+        seen.add(id(node))
+        members = getattr(node, "l", None)
+        if isinstance(members, (list, tuple)):
+            for m in members:
+                walk(m, depth + 1)
+            return
+        names.append(type(node).__name__)
+        walk(getattr(node, "loss", None), depth + 1)
+
+    walk(loss)
+    return names
+
+
+def audit_c1(term_names: list[str], model_names: list[str]) -> list[str]:
+    """C1: the design objective may not contain ipSAE and may not run on ESMFold2.
+
+    Derived from the actual composed loss, never asserted. ESMFoldGlobularity and
+    ESMFoldInterContact are NOT ESMFold2 models -- they are model-agnostic terms on
+    whatever distogram they are handed -- so they are matched exactly and allowed, while
+    anything else carrying the name is a violation.
+    """
+    allowed_esmfold_terms = {"ESMFoldGlobularity", "ESMFoldInterContact"}
+    bad = []
+    for name in term_names:
+        if "IPSAE" in name.upper():
+            bad.append(f"C1: loss term {name} contains ipSAE, the frozen ranking instrument")
+        if "ESMFOLD" in name.upper() and name not in allowed_esmfold_terms:
+            bad.append(f"C1: loss term {name} looks like an ESMFold2 term")
+    for name in model_names:
+        if "ESMFOLD" in name.upper():
+            bad.append(f"C1: design ran on model {name}; ESMFold2 is reserved for ranking")
+    return bad
+
+

+    # did any design place its titratable residue? It printed "STEP 4 PASSED: 0/1", which a
+    # reader scanning for PASSED takes as success when in fact no design passed geometry.
+    # Completion is reported as RAN/FAILED; geometry gets its own verdict line.
+    print(f"[mosaic] STEP 4 {'RAN' if rows else 'FAILED - no designs'}: {len(rows)} designs")
+    if rows:
+        read = [r for r in rows if r.get("geometry_read")]
+        if not read:
+            # D-P2-1: every design is below the iptm bar, so "0 passed" would be a false
+            # negative -- nothing was measured. Say that instead.
+            print(f"[mosaic] ⬛ GEOMETRY n/a on all {len(rows)} designs: none reached "
+                  f"iptm_repred {GEOMETRY_IPTM_BAR} (D-P2-1), so placement was never "
+                  f"measurable. This is NOT a geometry failure.")
+        else:
+            print(f"[mosaic] {'✅' if passed else '🔴'} GEOMETRY {len(passed)}/{len(read)} "
+                  f"within 4.0 A of {anchor_label}"
+                  + ("" if passed else " -- NO design placed its histidine")
+                  + (f"; {len(rows) - len(read)} more n/a below the iptm bar"
+                     if len(read) != len(rows) else ""))
+    if suspect:
+        print(f"[mosaic] 🔴 {len(suspect)}/{len(rows)} rows have SUSPECT METRICS: "
+              f"{', '.join(suspect)} -- see metrics_ok in designs.tsv")
+    else:
+        print(f"[mosaic] metrics audit clean on all {len(rows)} rows")
+    return [(rel, content) for rel, content in files.items()]
+
+
+@app.local_entrypoint()
+def main(
+    step: int = 1,
+    target: str = "../targets/egfr/egfr_ecd_6aru_renum.pdb",
+    target_chain: str = "A",
+    anchor_chain: str = "A",
+    target2: str = "",
+    target2_chain: str = "A,B",
+    target2_epitope: str = "",
+    target2_anchor: int = 0,
+    target2_anchor_chain: str = "A",
+    w_species: float = 1.0,
+    run_name: str = "",
+    out_dir: str = "../runs/mosaic",
+    crop: str = "284:453",
+    epitope: str = DEFAULT_EPITOPE,
+    anchor: int = ANCHOR,
+    lengths: str = "76",
+    n_seeds: int = 2,
+    seed0: int = 0,
+    steps_soft: int = 60,
+    steps_sharp: int = 40,
+    recycling_steps: int = 1,
+    sampling_steps: int = 10,
+    stepsize: float = 0.0,
+    sharpen: float = 1.3,
+    grad_samples: int = 1,
+    momentum_soft: float = 0.9,
+    momentum_sharp: float = 0.5,
+    use_mpnn: bool = True,
+    w_acid: float = 2.0,
+    w_mpnn: float = 3.0,
+    w_plddt: float = 1.0,
+    w_monomer: float = 0.5,
+    # The BINDING weights. These existed on design() but not here, so the only way to retune
+    # the balance between "get onto the target" and "place the histidine" was to edit the file
+    # -- or to move w_acid, which changes the same ratio from the other side. Found while
+    # probing a run where w_acid 2.0 outweighed w_iptm 1.0 and w_contact 1.0 on designs that
+    # were not binding at all. Defaults are identical to design()'s, so nothing changes
+    # unless a flag is passed.
+    w_iptm: float = 1.0,
+    w_contact: float = 1.0,
+    w_pae: float = 0.05,
+    w_within: float = 1.0,
+    w_glob: float = 0.3,
+    w_comp: float = 10.0,
+    cap_val: float = 0.12,
+    cap_gly: float = 0.08,
+    cap_his: float = 0.08,
+    acid_d0: float = 8.0,
+    his_d0: float = 6.5,
+    mechanism: str = "acid_near_his",
+    acid_eps: float = 1e-3,
+    smoke: bool = False,
+):
+    """Steps 1-3 are probes and take no arguments. Step 4 designs.
+
+    GPU=L40S modal run --detach modal_mosaic.py --step 4 --smoke --run-name smoke01
+    """
+    from datetime import datetime
+    from pathlib import Path
+
+    if step != 4:
+        print({1: probe, 2: probe_mosaic, 3: fetch_weights}[step].remote())
+        return
+
+    pdb = Path(target)
+    if not pdb.is_file():
+        raise SystemExit(f"target not found: {pdb.resolve()}  (paths resolve from biomodals/)")
+    # SIZE THE TIMEOUT FROM THE WORKLOAD, and refuse to launch under it. The default
+    # TIMEOUT=30 (and the 90 that design-mosaic.sh passes) is below the measured wall clock
+    # for the three-leg defaults: steps_soft 60 + steps_sharp 40 = 100 steps x n_seeds 2 x
+    # len(lengths), at a MEASURED 25.9 s/step for human-trimer + mouse-dimer (s37), is 86+
+    # minutes before three JAX compiles and the step-4 re-predictions.
+    #
+    # The rate is measured, not extrapolated -- s33 records a step-time extrapolation missing
+    # by 2.1x, and s37 records one that was infeasible on memory and not just slow. A NEW
+    # configuration should be smoke-tested for its own rate rather than trusted to this one.
+    # Same pattern as bin/score-esmfold2.sh, for the same reason: output is worth nothing if
+    # the run is cut off, and the GPU time is billed either way.
+    _n_traj = max(1, int(n_seeds)) * max(1, len([v for v in lengths.split(",") if v.strip()]))
+    _steps = (3 + 2) if smoke else (int(steps_soft) + int(steps_sharp))
+    # Measured rates, with a SAFETY FACTOR, because the same configuration does not
+    # reproduce to better than ~20%: the species leg measured 25.9 s/step on p2species02 and
+    # 30.6 s/step on p2dry03 -- identical tokens, legs and length, +18% apart. The ESMFold
+    # estimator missed in the other direction by a similar margin (239s actual vs 335s
+    # predicted). A point estimate is not safe here, so the factor is explicit rather than
+    # hidden in a rounded constant.
+    _s_per_step = (30.6 if target2 else 25.0) * 1.15
+    _est_min = (3 * 420 + _n_traj * (_steps * _s_per_step + 300)) / 60 + 1
+    print(f"[mosaic] {_n_traj} trajectories x {_steps} steps at ~{_s_per_step}s "
+          f"-> estimate ~{_est_min:.0f} min; TIMEOUT={TIMEOUT} min")
+    if TIMEOUT < _est_min:
+        raise SystemExit(
+            f"REFUSING TO LAUNCH: TIMEOUT={TIMEOUT} min is below the ~{_est_min:.0f} min\n"
+            f"  estimate. Designs are persisted per-design to the Volume, so a timeout no\n"
+            f"  longer loses everything -- but it still truncates the run and bills for the\n"
+            f"  GPU time. Raise TIMEOUT (minutes), or cut n_seeds/lengths/steps."
+        )
+
+    # Read the species target HERE, on the laptop, and fail before paying for a container.
+    target2_bytes = b""
+    if target2:
+        p2 = Path(target2)
+        if not p2.is_file():
+            raise SystemExit(f"--target2 not found: {p2.resolve()}  "
+                             f"(paths resolve from biomodals/)")
+        target2_bytes = p2.read_bytes()
+    run = run_name or datetime.now().strftime("%y%m%d%H%M")
+    results = design.remote(
+        target_pdb=pdb.read_bytes(), run_name=run, crop=crop, epitope=epitope,
+        target_chain=target_chain, anchor_chain=anchor_chain,
+        target_name=pdb.name, target2_name=(Path(target2).name if target2 else ""),
+        target2_pdb=target2_bytes, target2_chain=target2_chain,
+        target2_epitope=target2_epitope, target2_anchor=target2_anchor,
+        target2_anchor_chain=target2_anchor_chain, w_species=w_species,
+        anchor=anchor, lengths=lengths, n_seeds=n_seeds, seed0=seed0,
+        steps_soft=steps_soft, steps_sharp=steps_sharp,
+        recycling_steps=recycling_steps, sampling_steps=sampling_steps,
+        stepsize=stepsize, sharpen=sharpen, use_mpnn=use_mpnn, w_acid=w_acid,
+        grad_samples=grad_samples, momentum_soft=momentum_soft,
+        momentum_sharp=momentum_sharp,
+        w_mpnn=w_mpnn, w_plddt=w_plddt, w_monomer=w_monomer,
+        w_iptm=w_iptm, w_contact=w_contact, w_pae=w_pae, w_within=w_within,
+        w_glob=w_glob, w_comp=w_comp,
+        cap_val=cap_val, cap_gly=cap_gly, cap_his=cap_his, acid_d0=acid_d0, acid_eps=acid_eps,
+        his_d0=his_d0, mechanism=mechanism,
+        smoke=smoke,
+    )
+    dest = Path(out_dir) / run
+    for rel, content in results:
+        p = dest / rel
+        p.parent.mkdir(parents=True, exist_ok=True)
+        p.write_bytes(content)
+    print(f"\nResults saved to: {dest}")

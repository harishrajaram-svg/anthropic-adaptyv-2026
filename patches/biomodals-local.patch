+        grad_samples == 1 is byte-for-byte the previous behaviour. Above 1 this averages the
+        loss over several structure+confidence passes from a single trunk output, which is the
+        variance reduction the flat-trajectory question needs. The MONOMER leg deliberately
+        does NOT go through here: it carries pLDDT, within-binder contact and globularity and
+        no interface term, so averaging it costs GPU memory for no bearing on the question.
+        NB: the human trimer alone is NOT the ceiling (456 res / 532 tokens, 21.7 s/step). It is
+        the DUAL-SPECIES graph that OOMs with a mouse trimer (~976 tokens); mouse dimer at 828
+        tokens runs at 25.9 s/step. An earlier comment here overstated this and ruled out options.
+        """
+        if grad_samples > 1:
+            return model.build_multisample_loss(
+                loss=loss, features=features, recycling_steps=recycling_steps,
+                sampling_steps=sampling_steps, num_samples=grad_samples,
+            )
+        return model.build_loss(
+            loss=loss, features=features,
+            recycling_steps=recycling_steps, sampling_steps=sampling_steps,
+        )
+
+    mpnn = None
+    if use_mpnn:
+        # The published Nipah-winning recipe is Boltz-2 + SOLUBLE ProteinMPNN +
+        # simplex_APGM, and InverseFoldingSequenceRecovery is the term mosaic credits with
+        # raising filter pass rates. Optional and non-fatal: if the weights will not load
+        # the run continues without it rather than dying 20 minutes in.
+        try:
+            from mosaic.losses.protein_mpnn import InverseFoldingSequenceRecovery
